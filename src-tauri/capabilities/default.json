{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "design-system"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "opener:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "fs:default",
    "dialog:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "allow-start-indexing",
    "allow-create-tag",
    "allow-update-tag",
    "allow-delete-tag",
    "allow-get-all-tags",
    "allow-add-tag-to-asset",
    "allow-remove-tag-from-asset",
    "allow-get-tags-for-asset",
    "allow-add-tags-to-assets-batch",
    "allow-remove-tags-from-assets-batch",
    "allow-replace-tags-for-assets-batch",
    "allow-get-assets-filtered",
    "allow-get-asset-count-filtered",
    "allow-get-library-stats",
    "allow-update-asset-rating",
    "allow-update-asset-notes",
    "allow-get-asset-exif",
    "allow-request-thumbnail-regenerate",
    "allow-add-location",
    "allow-remove-location",
    "allow-get-locations",
    "allow-get-all-subfolders",
    "allow-get-subfolder-counts",
    "allow-get-location-root-counts",
    "allow-get-smart-folders",
    "allow-save-smart-folder",
    "allow-update-smart-folder",
    "allow-delete-smart-folder",
    "allow-get-setting",
    "allow-set-setting",
    "allow-run-db-maintenance",
    "allow-send-telemetry-log",
    "allow-get-library-supported-formats",
    "allow-get-audio-waveform-data",
    "allow-get-cache-stats",
    "allow-cleanup-cache",
    "allow-clear-cache",
    "allow-set-thumbnail-priority",
    "allow-get-streaming-token",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:9876/*" },
        { "url": "http://localhost:9876/*" }
      ]
    }
  ]
}
